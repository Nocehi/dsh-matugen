{
  "name": "dsh-matugen",
  "version": "0.1.1",
  "description": "Matugen/DankMaterialShell palette bridge for DeepSeek Harness Web themes",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./core": "./src/core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/build-client.mjs",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepare": "npm run build",
    "test": "node --test tests/build-client.test.js tests/client-bundle.test.js tests/client.test.js tests/core.test.js tests/host.test.js",
    "test:artifact": "node --test tests/build-client.test.js tests/client-bundle.test.js",
    "test:rc6": "node --test tests/rc6-runtime.test.js",
    "check": "node --check src/core.js && node --check src/index.js && node --check src/client.js && node --check scripts/build-client.mjs && npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nocehi/dsh-matugen.git"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
